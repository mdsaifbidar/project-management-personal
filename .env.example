# Copy to .env.local for local development, or add these in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Postgres connection string (Neon: Dashboard → Connect → "Pooled connection").
# Leave empty to run in browser-only mode.
DATABASE_URL=

# The password you'll use to sign in. Required whenever DATABASE_URL is set.
APP_PASSWORD=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
